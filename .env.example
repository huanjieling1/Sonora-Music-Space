# MySQL
DB_URL=jdbc:mysql://localhost:3306/agent_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=change_me

# SMTP: fill these values to send real verification emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=your_smtp_authorization_code
SMTP_FROM=sender@example.com
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false

# Zhipu GLM official OpenAI-compatible API. Leave AGENT_API_KEY empty to run only authentication.
AGENT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AGENT_API_KEY=
AGENT_MODEL=glm-4-flash-250414
AGENT_TEMPERATURE=0.0
AGENT_MAX_TOKENS=4096
AGENT_MEMORY_MAX_MESSAGES=20
AGENT_TIMEOUT_SECONDS=60
AGENT_LOG_REQUESTS=false
AGENT_LOG_RESPONSES=false

# Pure-Java personalized recommendation. Embedding API defaults to the GLM credentials above.
MUSIC_PERSONALIZATION_ENABLED=true
AGENT_EMBEDDING_ENABLED=true
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AGENT_EMBEDDING_MODEL=embedding-3
AGENT_EMBEDDING_DIMENSIONS=512
AGENT_EMBEDDING_TIMEOUT_SECONDS=8
AGENT_EMBEDDING_BATCH_SIZE=64

# Neo4j 5.26 LTS, loopback-only. Never commit the password.
NEO4J_ENABLED=true
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me
NEO4J_DATABASE=neo4j
MUSIC_RANK_POLICY_ACTIVE_VERSION=baseline-v1
SESSION_COOKIE_SECURE=false
# Use a long random value and keep it stable, otherwise existing remembered logins become invalid.
REMEMBER_ME_KEY=replace_with_a_long_random_secret
REMEMBER_ME_VALIDITY_DAYS=30
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Open music catalogs. Configure Jamendo or Audius; YouTube is an optional fallback.
JAMENDO_CLIENT_ID=
AUDIUS_API_KEY=
YOUTUBE_API_KEY=
MUSIC_PROVIDER_TIMEOUT_SECONDS=5

# Personal, loopback-only QQ Music integration. Sonora opens an isolated Edge profile and captures only the required QQ Music session fields.
QQ_MUSIC_ENABLED=true
QQ_MUSIC_BRIDGE_URL=http://127.0.0.1:3200
QQ_MUSIC_SESSION_DIRECTORY=runtime-data
QQ_MUSIC_DEFAULT_QUALITY=flac
